rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    function ownUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /productos/{id} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /contenido/{id} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /atracciones/{id} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /servicios/{id} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /usuarios/{uid} {
      allow create: if ownUser(uid) && request.resource.data.rol == 'cliente';
      allow read: if ownUser(uid) || admin();
      // El admin puede cambiar el rol de otros, pero no el suyo (evita que se
      // quede sin acceso al panel por error). Nadie cambia su propio rol.
      allow update: if (admin() && uid != request.auth.uid) || (ownUser(uid) && request.resource.data.rol == resource.data.rol);
      allow delete: if admin() && uid != request.auth.uid;

      match /carrito/{itemId} {
        allow read, write: if ownUser(uid);
      }
    }

    match /reservas/{id} {
      function propia() {
        return signedIn() && resource.data.uid == request.auth.uid;
      }

      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if admin() || propia();
      // Una reserva pagada ya no la puede editar ni eliminar el cliente (solo el admin).
      // Pagarla sí está permitido: en ese momento todavía figura como no pagada.
      allow update: if admin() || (propia() && resource.data.pagado != true && request.resource.data.uid == resource.data.uid);
      allow delete: if admin() || (propia() && resource.data.pagado != true);
    }

    match /transacciones/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if admin();
    }

    match /configuracion/{document} {
      // Solo los administradores pueden editar la configuración
      allow write: if signedIn() && (
        request.auth.uid in ['G3yhr3oVJmZDqFgIkhDOINI6bWJ3', 'eSsCKeqTVGUJSg6Cq3brTGFTgP52', 'twsR7FgxkCOM3ozoP2FN5E7vFzL2', '3qElw9uNAKZwTNbEcHqlZMXnm053'] || admin()
      );
      allow read: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
